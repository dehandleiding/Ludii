let musicPlayer=null;
const MUSIC_DATA="data:audio/wav;base64,";
function toggleMusic(){
  if(!musicPlayer){
    musicPlayer=new Audio(MUSIC_DATA);
    musicPlayer.loop=true;
    musicPlayer.volume=.42;
    musicPlayer.onplay=()=>{document.getElementById("musicBtn").textContent="♫ Muziek uit";document.getElementById("musicBtn").classList.add("on")};
    musicPlayer.onpause=()=>{document.getElementById("musicBtn").textContent="♫ Muziek aan";document.getElementById("musicBtn").classList.remove("on")};
  }
  if(musicPlayer.paused) musicPlayer.play().catch(()=>toast("Tik nogmaals op Muziek aan als iOS het afspelen blokkeert."));
  else musicPlayer.pause();
}
document.getElementById("musicBtn").onclick=toggleMusic;

startLocal();
