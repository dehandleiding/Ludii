<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Speel als een Romein — Ludus Romanus</title>
<script src="https://unpkg.com/peerjs@1.5.5/dist/peerjs.min.js"></script>
<style>
:root{
  --marble:#efe3c8; --parch:#f8efd9; --parch2:#ead9b8; --ink:#2b2118;
  --wine:#6f2522; --gold:#b48738; --gold2:#d7b86a; --green:#506b43;
  --stone:#51483d; --shadow:#291d1433; --black:#181715; --ivory:#eee4cc;
}
*{box-sizing:border-box}
body{margin:0;color:var(--ink);font-family:Georgia,'Times New Roman',serif;
background:
 radial-gradient(circle at 20% 10%,#fff8 0 2px,transparent 3px),
 radial-gradient(circle at 70% 80%,#6b4b2420 0 1px,transparent 2px),
 linear-gradient(135deg,#d9c39b,#f3e7cd 48%,#d1b987);
background-size:120px 120px,90px 90px,auto; min-height:100vh}
.app{max-width:1180px;margin:auto;padding:18px}
header{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:15px}
.brand{display:flex;gap:14px;align-items:center}.laurel{font-size:38px;filter:sepia(.8)}
h1{font-size:clamp(28px,5vw,48px);margin:0;letter-spacing:.02em;color:#3b281a}
.subtitle{font-size:14px;color:#71563a;margin-top:2px}
button,select,input{font:inherit}
button{border:1px solid #b89a63;background:linear-gradient(#fff8e9,#dfc99f);color:#2f2116;
padding:10px 14px;border-radius:10px;cursor:pointer;font-weight:700;box-shadow:0 2px 5px #4b31151f}
button:hover{filter:brightness(.98);transform:translateY(-1px)}
button.primary{background:linear-gradient(#9a3b31,#641d1c);color:#fff;border-color:#5b1918}
button.gold{background:linear-gradient(#e6c978,#b98a32);color:#25190e;border-color:#8e6828}
button.danger{background:#eee0d0}
.card{background:linear-gradient(145deg,#fff8e8eF,#f0e1c3ee);border:2px solid #b89b68;
box-shadow:0 10px 30px var(--shadow), inset 0 0 0 4px #ffffff55;border-radius:18px}
.topbar{padding:12px 15px;display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.topbar .spacer{flex:1}
.layout{display:grid;grid-template-columns:minmax(420px,1fr) 340px;gap:16px}
@media(max-width:850px){.layout{grid-template-columns:1fr}.side{order:-1}}
.boardcard{padding:15px}
.boardtitle{display:flex;justify-content:space-between;align-items:center;margin:0 0 8px}
.turn{font-weight:800;color:var(--wine)}
.boardwrap{position:relative;width:100%;max-width:760px;margin:auto}
svg#board{width:100%;height:auto;display:block;border-radius:15px;background:#cdb58b;box-shadow:inset 0 0 35px #3d2b1940,0 7px 15px #3c28152a}
.boardline{stroke:#494238;stroke-width:8;stroke-linecap:round;stroke-linejoin:round;filter:drop-shadow(0 2px 1px #0003)}
.node{fill:#a99b82;stroke:#4d4439;stroke-width:3}
.node.available{fill:#9caf7f;stroke:#425c38;stroke-width:5;cursor:pointer}
.node.selected{fill:#e3b866;stroke:#74321f;stroke-width:6}
.piece{cursor:pointer;transition:transform .15s}
.piece:hover{filter:brightness(1.12)}
.piece circle{stroke:#e9d9ae;stroke-width:3;filter:drop-shadow(0 4px 3px #0007)}
.piece.hunter circle{fill:url(#blackCoin)}
.piece.prey circle{fill:url(#ivoryCoin)}
.piece text{font-size:17px;font-weight:bold;text-anchor:middle;dominant-baseline:central;pointer-events:none}
.piece.hunter text{fill:#e8d8af}.piece.prey text{fill:#5b321e}
.statusbar{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-top:10px;padding:10px 12px;background:#5e241f;color:#fff1d4;border-radius:10px}
.statusbar b{font-size:18px}
.controls{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.side{padding:16px}
h2{font-size:19px;margin:3px 0 10px;color:#5d251e}
.panel{border-top:1px solid #c6aa76;margin-top:14px;padding-top:14px}
.scoregrid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.scorebox{background:#f1e2c2;border:1px solid #c4a76c;border-radius:10px;padding:9px;text-align:center}
.scorebox .big{font-size:27px;font-weight:800;color:#5d251e}
table{width:100%;border-collapse:collapse;font-size:13px}td,th{padding:6px 4px;border-bottom:1px solid #d6c097;text-align:left}
.rules{font-size:13px;line-height:1.45;margin:0;padding-left:20px}.rules li{margin:5px 0}
.log{height:135px;overflow:auto;background:#2e241d;color:#f3e5c5;border-radius:9px;padding:8px;font-family:ui-monospace,monospace;font-size:12px}
.modal{position:fixed;inset:0;background:#24170caa;display:flex;align-items:center;justify-content:center;padding:18px;z-index:10}
.modal.hidden{display:none}.modalbox{max-width:560px;width:100%;padding:22px}.modalbox h2{font-size:27px;margin-top:0}
.formrow{display:flex;gap:8px;flex-wrap:wrap;margin:9px 0}.formrow>*{flex:1;min-width:150px}
input,select{border:1px solid #bda16d;background:#fff9ec;padding:10px;border-radius:9px}
.hint{font-size:12px;color:#70583b}.code{font-size:28px;letter-spacing:5px;text-align:center;padding:12px;background:#2f241d;color:#f2d27f;border-radius:10px;margin:10px 0}
.music.on{background:#5d251e;color:#fff}
#toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);background:#2e241d;color:#fff2d4;padding:10px 15px;border-radius:10px;opacity:0;pointer-events:none;transition:.25s;z-index:20}
#toast.show{opacity:1}
</style>
</head>
<body>
<div class="app">
<header>
  <div class="brand"><div class="laurel">🏛️</div><div><h1>Ludus Romanus</h1><div class="subtitle">Speel als een Romein · digitaal bordspel</div></div></div>
  <button id="musicBtn" class="music">♫ Muziek aan</button>
</header>

<div class="topbar card">
  <button class="primary" id="aiBtn">🤖 Tegen de AI</button>
  <button id="localBtn">👥 Twee spelers</button>
  <button id="onlineBtn">🌐 Online met vriend</button>
  <span class="spacer"></span>
  <button id="newMatchBtn">Nieuwe wedstrijd</button>
  <button id="undoBtn">↶ Zet terug</button>
</div>

<div class="layout">
<section class="boardcard card">
  <div class="boardtitle"><h2>Het Romeinse spelbord</h2><span id="modeBadge">Kies een spelmodus</span></div>
  <div class="boardwrap">
    <svg id="board" viewBox="0 0 700 760" aria-label="Romeins spelbord">
      <defs>
        <radialGradient id="stoneBg"><stop offset="0" stop-color="#efe4cc"/><stop offset=".7" stop-color="#d8c39a"/><stop offset="1" stop-color="#bfa47a"/></radialGradient>
        <radialGradient id="blackCoin"><stop offset="0" stop-color="#51463b"/><stop offset=".55" stop-color="#252321"/><stop offset="1" stop-color="#090909"/></radialGradient>
        <radialGradient id="ivoryCoin"><stop offset="0" stop-color="#fff8df"/><stop offset=".65" stop-color="#d9c59d"/><stop offset="1" stop-color="#a48d68"/></radialGradient>
        <filter id="rough"><feTurbulence baseFrequency=".035" numOctaves="2" seed="3" result="n"/><feBlend in="SourceGraphic" in2="n" mode="multiply"/></filter>
      </defs>
      <rect x="0" y="0" width="700" height="760" fill="url(#stoneBg)"/>
      <path d="M30 30H670V730H30Z" fill="none" stroke="#8b7048" stroke-width="5" opacity=".4"/>
      <g id="edges"></g><g id="nodes"></g><g id="pieces"></g>
    </svg>
  </div>
  <div class="statusbar"><span id="turnText">Kies eerst een spelmodus.</span><span>Jagerzetten: <b id="moves">0</b></span></div><div style="margin-top:7px;text-align:center;font-size:13px;color:#6d5236">📱 Geef de telefoon door wanneer de andere speler aan de beurt is.</div>
  <div class="controls">
    <button class="gold" id="roundBtn">Volgende ronde</button>
    <button id="helpBtn">Speluitleg</button>
  </div>
</section>

<aside class="side card">
  <h2>🏆 Scorebord</h2>
  <div class="scoregrid">
    <div class="scorebox">Jager<br><span class="big" id="hunterWins">0</span><br><small>rondewinsten</small></div>
    <div class="scorebox">Prooi<br><span class="big" id="preyWins">0</span><br><small>rondewinsten</small></div>
  </div>
  <div class="panel">
    <h2>Wedstrijd</h2>
    <div id="matchInfo" class="hint">Nog geen wedstrijd gestart.</div>
  </div>
  <div class="panel">
    <h2>Rondes</h2>
    <table><thead><tr><th>Ronde</th><th>Jagerzetten</th><th>Winnaar</th></tr></thead><tbody id="scoreRows"></tbody></table>
  </div>
  <div class="panel">
    <h2>Spelregels</h2>
    <ul class="rules">
      <li>De jager heeft 4 stenen; de prooi 2.</li>
      <li>De jager begint.</li>
      <li>Een steen gaat maximaal één kruispunt langs een getekende lijn.</li>
      <li>Je mag niet over een andere steen springen.</li>
      <li>Geen twee stenen op hetzelfde kruispunt.</li>
      <li>Een prooi-steen is ingesloten als hij niet meer kan bewegen.</li>
      <li>De ronde eindigt als beide prooi-stenen ingesloten zijn.</li>
      <li>Tel alleen de zetten van de jager.</li>
      <li>Daarna worden de rollen omgedraaid.</li>
    </ul>
  </div>
  <div class="panel"><h2>Logboek</h2><div id="log" class="log"></div></div>
</aside>
</div>
</div>

<div id="modal" class="modal hidden"><div class="modalbox card" id="modalContent"></div></div>
<div id="toast"></div>

<script>
/* Het bord volgt het bord op pagina 2 van het aangeleverde PDF:
   14 kruispunten: vier boven, vier onder, drie extra aan iedere zijkant.
   Lijnen: buitenrand, vier diagonalen en de horizontale middellijn.
   De startstenen volgen pagina 1: vier jagers rechts, twee prooien links. */

const P=[
 [90,105],[265,105],[435,105],[610,105],
 [610,245],[610,380],[610,515],
 [610,655],[435,655],[265,655],[90,655],
 [90,515],[90,380],[90,245]
];
const E=[
 [0,1],[1,2],[2,3],              // top
 [3,4],[4,5],[5,6],[6,7],        // right side
 [7,8],[8,9],[9,10],              // bottom
 [10,11],[11,12],[12,13],[13,0],  // left side
 [13,1], [2,4],                   // upper diagonals
 [11,9], [8,6],                   // lower diagonals
 [12,5]                           // exact horizontal middle
];
const adj=Array.from({length:P.length},()=>new Set());
E.forEach(([a,b])=>{adj[a].add(b);adj[b].add(a)});

let game=null,mode="none",myRole=null,aiRole=null,selected=null,history=[],aiLevel=5,aiThinking=false;
let roundResults=[], wins={hunter:0,prey:0}, peer=null, conn=null,isHost=false;
let audio=null;

function initialGame(){
 return {round:1,turn:"hunter",hunterMoves:0,
 pieces:[
  {id:"J1",role:"hunter",pos:3},{id:"J2",role:"hunter",pos:4},
  {id:"J3",role:"hunter",pos:6},{id:"J4",role:"hunter",pos:7},
  {id:"P1",role:"prey",pos:0},{id:"P2",role:"prey",pos:10}
 ]};
}
function occ(pos){return game.pieces.find(p=>p.pos===pos)}
function legalMoves(piece){return [...adj[piece.pos]].filter(n=>!occ(n))}
function trapped(piece){return legalMoves(piece).length===0}
function finished(){return game.pieces.filter(p=>p.role==="prey").every(trapped)}
function clone(x){return JSON.parse(JSON.stringify(x))}
function save(){history.push(clone(game));if(history.length>40)history.shift()}
function toast(t){let x=document.getElementById("toast");x.textContent=t;x.classList.add("show");setTimeout(()=>x.classList.remove("show"),1800)}
function log(t){let l=document.getElementById("log");l.innerHTML+=`<div>${t}</div>`;l.scrollTop=l.scrollHeight}

function draw(){
 const eg=document.getElementById("edges"),ng=document.getElementById("nodes"),pg=document.getElementById("pieces");
 eg.innerHTML="";ng.innerHTML="";pg.innerHTML="";
 E.forEach(([a,b])=>{let l=document.createElementNS("http://www.w3.org/2000/svg","line");l.setAttribute("x1",P[a][0]);l.setAttribute("y1",P[a][1]);l.setAttribute("x2",P[b][0]);l.setAttribute("y2",P[b][1]);l.setAttribute("class","boardline");eg.appendChild(l)});
 const available=selected==null?new Set():new Set(legalMoves(game.pieces.find(p=>p.pos===selected)));
 P.forEach((xy,i)=>{
   let c=document.createElementNS("http://www.w3.org/2000/svg","circle");c.setAttribute("cx",xy[0]);c.setAttribute("cy",xy[1]);c.setAttribute("r",selected===i?15:10);
   c.setAttribute("class","node"+(selected===i?" selected":"")+(available.has(i)?" available":""));
   c.addEventListener("click",()=>clickNode(i));ng.appendChild(c);
 });
 game?.pieces.forEach(p=>{
   let g=document.createElementNS("http://www.w3.org/2000/svg","g");g.setAttribute("class","piece "+p.role);
   let c=document.createElementNS("http://www.w3.org/2000/svg","circle");c.setAttribute("cx",P[p.pos][0]);c.setAttribute("cy",P[p.pos][1]);c.setAttribute("r",28);g.appendChild(c);
   let t=document.createElementNS("http://www.w3.org/2000/svg","text");t.setAttribute("x",P[p.pos][0]);t.setAttribute("y",P[p.pos][1]);t.textContent=p.role==="hunter"?"J":"P";g.appendChild(t);
   g.addEventListener("click",e=>{e.stopPropagation();clickPiece(p.id)});pg.appendChild(g);
 });
 updatePanel();
}
function updatePanel(){
 if(!game){document.getElementById("turnText").textContent="Kies eerst een spelmodus.";document.getElementById("modeBadge").textContent="Geen spel";return}
 let actor=game.turn==="hunter"?"Jager":"Prooi";
 if(mode==="ai") actor=(game.turn===myRole?"Jij":"AI")+" · "+actor+(aiThinking?" · denkt…":"");
 if(mode==="online") actor=(game.turn===myRole?"Jij":"Vriend")+" · "+actor;
 document.getElementById("turnText").textContent=actor+" is aan de beurt";
 document.getElementById("moves").textContent=game.hunterMoves;
 document.getElementById("modeBadge").textContent=mode==="ai"?"🤖 AI":mode==="online"?"🌐 Online":"👥 2 spelers";
 document.getElementById("hunterWins").textContent=wins.hunter;
 document.getElementById("preyWins").textContent=wins.prey;
 document.getElementById("matchInfo").textContent=`Ronde ${game.round} · ${roundResults.length} afgerond`+(mode==="ai"?` · AI ${aiLevel}/10`:"");
 document.getElementById("scoreRows").innerHTML=roundResults.map(r=>`<tr><td>${r.round}</td><td>${r.moves}</td><td>${r.winner}</td></tr>`).join("");
}
function clickPiece(id){
 if(!game||game.turn===null||aiThinking)return;
 if(mode==="ai"&&game.turn!==myRole)return;
 if(mode==="online"&&game.turn!==myRole)return;
 let p=game.pieces.find(x=>x.id===id);if(!p||p.role!==game.turn)return;
 selected=p.pos;draw();
}
function clickNode(pos){
 if(selected==null||!game)return;
 let p=game.pieces.find(x=>x.pos===selected);
 if(!p||p.role!==game.turn||!adj[selected].has(pos)||occ(pos))return;
 makeMove(p.id,pos);
}
function makeMove(id,to){
 let p=game.pieces.find(x=>x.id===id);
 if(!p||!adj[p.pos].has(to)||occ(to))return;
 save();p.pos=to;if(p.role==="hunter")game.hunterMoves++;
 selected=null;
 log(`${p.role==="hunter"?"Jager":"Prooi"}: ${id} → kruispunt ${to+1}`);
 if(finished()){endRound();return}
 game.turn=game.turn==="hunter"?"prey":"hunter";
 draw();
 if(mode==="ai"&&game.turn===aiRole)setTimeout(aiTurn,350);
 if(mode==="online")sendState();
}
function endRound(){
 game.turn=null;draw();
 const r={round:game.round,moves:game.hunterMoves,winner:"Jager"};
 wins.hunter++;roundResults.push(r);
 log(`<b>Ronde voorbij: jager blokkeerde de prooi in ${r.moves} zetten.</b>`);
 toast(`Ronde ${r.round} klaar · ${r.moves} jagerzetten`);
}
function newRound(){
 if(!game)return;
 if(game.turn!==null){if(!confirm("De huidige ronde is nog niet klaar. Toch opnieuw beginnen?"))return}
 if(mode==="online"&&!isHost){toast("De host start de volgende ronde.");return}
 game=initialGame();game.round=(roundResults.length+1);history=[];selected=null;
 if(mode==="ai"){let t=myRole;myRole=aiRole;aiRole=t}
 if(mode==="online"){let t=myRole;myRole=t==="hunter"?"prey":"hunter"}
 document.getElementById("log").innerHTML="";
 log(`Ronde ${game.round} gestart. Rollen zijn omgedraaid.`);
 draw();
 if(mode==="online")send({type:"newRound",state:game,hostRole:isHost?myRole:null});
 if(mode==="ai"&&game.turn===aiRole)setTimeout(aiTurn,500);
}
function newMatch(){
 if(peer){try{peer.destroy()}catch(e){}peer=null;conn=null}
 game=initialGame();roundResults=[];wins={hunter:0,prey:0};selected=null;history=[];mode="none";myRole=null;aiRole=null;
 document.getElementById("log").innerHTML="";log("Nieuwe wedstrijd. Kies een spelmodus.");
 draw();
}

/* Sterkere AI.
   Het bord is klein, dus we kunnen veel verder zoeken dan de vorige versie.
   Niveau 1-10 bepaalt zoekdiepte, move ordering en hoeveel varianten worden bekeken.
   De hoogste niveaus gebruiken alpha-beta, transposition table en een gerichte
   evaluatiefunctie voor insluiten, mobiliteit, afstand en tempo. */
const aiTT=new Map();

function stateKey(g){
  return g.turn+"|"+g.hunterMoves+"|"+g.pieces.slice().sort((a,b)=>a.id.localeCompare(b.id)).map(p=>p.role[0]+p.pos).join(",");
}
function cloneGame(g){return JSON.parse(JSON.stringify(g))}
function mobilityScore(g,role){
  return g.pieces.filter(p=>p.role===role).reduce((sum,p)=>{
    return sum + legalMovesOn(g,p).length;
  },0);
}
function legalMovesOn(g,p){
  const occupied=new Set(g.pieces.map(q=>q.pos));
  return [...adj[p.pos]].filter(n=>!occupied.has(n));
}
function isTerminal(g){
  return g.pieces.filter(p=>p.role==="prey").every(p=>legalMovesOn(g,p).length===0);
}
function evaluateAI(g){
  const prey=g.pieces.filter(p=>p.role==="prey");
  const hunter=g.pieces.filter(p=>p.role==="hunter");
  const blocked=prey.filter(p=>legalMovesOn(g,p).length===0).length;
  if(blocked===2)return 100000 - g.hunterMoves*120;
  const preyMob=mobilityScore(g,"prey");
  const hunterMob=mobilityScore(g,"hunter");
  const preyPositions=prey.map(p=>p.pos);
  const distances=prey.reduce((sum,p)=>{
    const near=Math.min(...hunter.map(h=>graphDistance(h.pos,p.pos)));
    return sum+near;
  },0);
  // Positive = good for hunter, negative = good for prey.
  return blocked*1800 - preyMob*45 + hunterMob*5 - distances*3 - g.hunterMoves*1.5;
}
function graphDistance(a,b){
  if(a===b)return 0;
  const q=[[a,0]],seen=new Set([a]);
  while(q.length){
    const [x,d]=q.shift();
    for(const n of adj[x]){
      if(n===b)return d+1;
      if(!seen.has(n)){seen.add(n);q.push([n,d+1])}
    }
  }
  return 99;
}
function generateMoves(g,role){
  const arr=[];
  g.pieces.filter(p=>p.role===role).forEach(p=>{
    legalMovesOn(g,p).forEach(to=>arr.push([p.id,to]));
  });
  return arr;
}
function applyAIMove(g,move){
  const [id,to]=move;
  const ng=cloneGame(g);
  const p=ng.pieces.find(x=>x.id===id);
  p.pos=to;
  if(p.role==="hunter")ng.hunterMoves++;
  ng.turn=p.role==="hunter"?"prey":"hunter";
  return ng;
}
function orderedMoves(g,moves,rootRole){
  return moves.map(m=>{
    const ng=applyAIMove(g,m);
    let score=evaluateAI(ng);
    if(ng.turn===rootRole)score += 0.01;
    return {m,score};
  }).sort((a,b)=>rootRole==="hunter"?b.score-a.score:a.score-b.score).map(x=>x.m);
}
function minimaxAI(g,depth,alpha,beta,rootRole){
  if(isTerminal(g))return {score:evaluateAI(g),move:null};
  if(depth<=0)return {score:evaluateAI(g),move:null};
  const key=stateKey(g)+"|"+depth+"|"+rootRole;
  const cached=aiTT.get(key);
  if(cached)return cached;

  const moves=orderedMoves(g,generateMoves(g,g.turn),rootRole);
  if(!moves.length)return {score:evaluateAI(g),move:null};

  const maximizing=g.turn==="hunter";
  let bestScore=maximizing?-Infinity:Infinity,bestMove=moves[0];

  for(const m of moves){
    const ng=applyAIMove(g,m);
    const result=minimaxAI(ng,depth-1,alpha,beta,rootRole);
    if(maximizing){
      if(result.score>bestScore){bestScore=result.score;bestMove=m}
      alpha=Math.max(alpha,bestScore);
    }else{
      if(result.score<bestScore){bestScore=result.score;bestMove=m}
      beta=Math.min(beta,bestScore);
    }
    if(beta<=alpha)break;
  }
  const result={score:bestScore,move:bestMove};
  aiTT.set(key,result);
  if(aiTT.size>50000){
    const first=aiTT.keys().next().value; aiTT.delete(first);
  }
  return result;
}
function chooseAIMove(){
  aiTT.clear();
  // Depth scales nonlinearly so levels 9-10 feel dramatically stronger.
  const depths=[1,1,2,3,4,5,6,7,8,10];
  const depth=depths[Math.max(0,Math.min(9,aiLevel-1))];
  const result=minimaxAI(cloneGame(game),depth,-Infinity,Infinity,aiRole);
  return result.move;
}
function aiTurn(){
  if(!game||mode!=="ai"||game.turn!==aiRole||aiThinking)return;
  aiThinking=true;
  draw();
  const wait=aiLevel>=8?180:120;
  setTimeout(()=>{
    const best=chooseAIMove();
    aiThinking=false;
    if(best)makeMove(best[0],best[1]);
  },wait);
}

/* Local AI mode */
function startAI(){
 mode="ai";
 myRole=document.getElementById("roleChoice")?.value||"hunter";
 aiRole=myRole==="hunter"?"prey":"hunter";
 aiLevel=Number(document.getElementById("aiLevel")?.value||5);
 game=initialGame();roundResults=[];wins={hunter:0,prey:0};history=[];selected=null;aiThinking=false;
 document.getElementById("log").innerHTML="";
 log(`AI-wedstrijd gestart. Jij bent ${myRole==="hunter"?"de jager":"de prooi"}. AI-niveau ${aiLevel}/10.`);
 closeModal();draw();
 if(game.turn===aiRole)setTimeout(aiTurn,450);
}
function startLocal(){mode="local";myRole=null;aiRole=null;game=initialGame();roundResults=[];wins={hunter:0,prey:0};history=[];selected=null;document.getElementById("log").innerHTML="";log("Twee spelers op één apparaat.");closeModal();draw()}

/* Online via PeerJS */
function send(obj){if(conn&&conn.open)conn.send(obj)}
function sendState(){send({type:"state",state:game})}
function setupConn(c,host){
 conn=c;
 c.on("open",()=>{
   document.getElementById("log").innerHTML="";log(host?"Vriend verbonden.":"Verbonden met de host.");
   if(host)send({type:"state",state:game,hostRole:myRole});
   closeModal();draw();
 });
 c.on("data",msg=>{
   if(msg.type==="state"){game=msg.state;if(!isHost&&msg.hostRole)myRole=msg.hostRole==="hunter"?"prey":"hunter";selected=null;draw()}
   if(msg.type==="newRound"){game=msg.state;myRole=msg.hostRole==="hunter"?"prey":"hunter";selected=null;draw()}
 });
 c.on("close",()=>{toast("De online verbinding is verbroken.");log("Verbinding verbroken.")});
 c.on("error",e=>log("Netwerkfout: "+e.type));
}
function openOnline(){
 const content=`<h2>🌐 Online spelen</h2>
 <p>Speel op twee apparaten. Eén speler maakt een spel en deelt de code met de ander.</p>
 <div class="formrow"><select id="onlineRole"><option value="hunter">Ik ben de jager</option><option value="prey">Ik ben de prooi</option></select></div>
 <div class="formrow"><button class="primary" id="makeGame">Maak spel</button><button id="joinGame">Doe mee</button></div>
 <div id="joinArea"></div><p class="hint">Voor online spelen hebben beide apparaten internet nodig.</p>`;
 showModal(content);
 document.getElementById("makeGame").onclick=()=>{
   isHost=true;mode="online";myRole=document.getElementById("onlineRole").value;game=initialGame();roundResults=[];wins={hunter:0,prey:0};
   peer=new Peer();peer.on("open",id=>{
     document.getElementById("joinArea").innerHTML=`<div class="code">${id}</div><div class="hint">Deel deze code met je vriend.</div>`;
   });
   peer.on("connection",c=>setupConn(c,true));document.getElementById("log").innerHTML="";log("Wacht op je vriend…");
 };
 document.getElementById("joinGame").onclick=()=>{
   const a=document.getElementById("joinArea");a.innerHTML=`<input id="peerId" placeholder="Plak de spelcode hier" style="width:100%">`;
   const b=document.createElement("button");b.textContent="Verbinden";b.className="primary";b.style.marginTop="8px";a.appendChild(b);
   b.onclick=()=>{isHost=false;mode="online";peer=new Peer();peer.on("open",()=>setupConn(peer.connect(document.getElementById("peerId").value,{reliable:true}),false));};
 };
}
function showModal(html){document.getElementById("modalContent").innerHTML=html;document.getElementById("modal").classList.remove("hidden")}
function closeModal(){document.getElementById("modal").classList.add("hidden")}
document.getElementById("modal").addEventListener("click",e=>{if(e.target.id==="modal")closeModal()});

document.getElementById("aiBtn").onclick=()=>{
 showModal(`<h2>🤖 Tegen de AI</h2>
 <p>Kies je rol en tik op een AI-niveau. Je kunt de balk ook slepen.</p>
 <div class="formrow">
   <select id="roleChoice">
     <option value="hunter">Ik ben de jager</option>
     <option value="prey">Ik ben de prooi</option>
   </select>
 </div>

 <div style="margin:18px 0">
   <div style="text-align:center;font-size:20px;font-weight:800;margin-bottom:10px">
     AI-niveau <span id="levelNumber">5</span>/10
   </div>

   <div id="levelButtons" style="display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-bottom:14px">
     ${Array.from({length:10},(_,i)=>`<button type="button" class="levelBtn" data-level="${i+1}" style="min-height:44px;border:2px solid #b99758;border-radius:10px;background:#f5e9c9;color:#3b2418;font-size:18px;font-weight:800">${i+1}</button>`).join("")}
   </div>

   <div style="display:flex;justify-content:space-between;font-size:13px;font-weight:700;margin-bottom:5px">
     <span>DOM</span><span>SUPER SUPER SLIM</span>
   </div>
   <input id="aiLevel" type="range" min="1" max="10" value="5" step="1"
     style="display:block;width:100%;height:38px;accent-color:#7b2d26;cursor:pointer">

   <div id="levelLabel" style="text-align:center;font-weight:800;font-size:17px;margin-top:8px">Niveau 5 · Slim</div>
   <div id="levelHint" style="text-align:center;font-size:13px;margin-top:5px">
     De AI zoekt meerdere zetten vooruit.
   </div>
 </div>

 <button class="primary" id="startAIBtn">Start spel</button>`);

 const slider=document.getElementById("aiLevel");
 const number=document.getElementById("levelNumber");
 const label=document.getElementById("levelLabel");
 const hint=document.getElementById("levelHint");
 const buttons=[...document.querySelectorAll(".levelBtn")];

 const labels=["Heel dom","Dom","Beginnend","Normaal","Slim","Erg slim","Sterk","Zeer sterk","Meesterlijk","Super super slim"];
 const hints=[
  "De AI kiest vaak een eenvoudige zet.",
  "De AI maakt af en toe een tactische keuze.",
  "De AI kijkt enkele zetten vooruit.",
  "De AI speelt redelijk doelgericht.",
  "De AI zoekt meerdere zetten vooruit.",
  "De AI ziet korte tactische dreigingen.",
  "De AI gebruikt diepere zoekopdrachten en mobiliteitsanalyse.",
  "De AI rekent veel varianten door.",
  "De AI zoekt diep en gebruikt zetvolgorde en transpositiecontrole.",
  "Maximale zoekdiepte binnen de mogelijkheden van de telefoon."
 ];

 function updateLevel(){
   const n=Math.max(1,Math.min(10,Number(slider.value)||5));
   slider.value=n;
   number.textContent=n;
   label.textContent=`Niveau ${n} · ${labels[n-1]}`;
   hint.textContent=hints[n-1];
   buttons.forEach(b=>{
     const active=Number(b.dataset.level)===n;
     b.style.background=active?"#7b2d26":"#f5e9c9";
     b.style.color=active?"#fff8e7":"#3b2418";
     b.style.transform=active?"scale(1.04)":"scale(1)";
   });
 }
 slider.addEventListener("input",updateLevel);
 buttons.forEach(b=>b.addEventListener("click",()=>{
   slider.value=b.dataset.level;
   updateLevel();
 }));
 updateLevel();
 document.getElementById("startAIBtn").onclick=startAI;
};
document.getElementById("localBtn").onclick=startLocal;
document.getElementById("onlineBtn").onclick=openOnline;
document.getElementById("newMatchBtn").onclick=newMatch;
document.getElementById("roundBtn").onclick=newRound;
document.getElementById("undoBtn").onclick=()=>{
 if(!history.length||!game||game.turn===null)return;
 if(mode==="online"){toast("Zet terug is alleen lokaal beschikbaar.");return}
 game=history.pop();selected=null;draw();log("Laatste zet teruggedraaid.");
 if(mode==="ai"&&game.turn===aiRole)setTimeout(aiTurn,300);
};
